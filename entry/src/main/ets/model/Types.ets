/**
 * Wire model shared with the Go core.
 *
 * Every interface here mirrors a struct in core/internal/{state,config,rpc}.
 * The field names are snake_case because they are literally the JSON keys the
 * core emits; do not "clean them up" into camelCase, the Go side will not
 * follow you.
 *
 * This file is the ONLY place allowed to describe JSON shapes. UI code casts at
 * the boundary (LocalRpc / CoreApi) and then works with these types.
 */

// ---------------------------------------------------------------------------
// state.Status  (core/internal/state/status.go)
// ---------------------------------------------------------------------------

export interface TunStatus {
  enabled: boolean;
  fd: number;
  mtu: number;
  up: boolean;
  err?: string;
}

export interface InboundStatus {
  name: string;
  addr: string;
  up: boolean;
  conn: number;
  err?: string;
}

export interface Health {
  heartbeat_ago_ms: number;
  goroutines: number;
  open_fds: number;
  heap_mb: number;
  restarts: number;
  last_error?: string;
  started_unix: number;
}

export interface Traffic {
  up: number;
  down: number;
  up_rate: number;
  down_rate: number;
  active: number;
  total_conn: number;
}

export interface NodeStatus {
  tag: string;
  type: string;
  remark?: string;
  delay_ms: number;
  alive: boolean;
  tested_at?: number;
}

export interface GroupStatus {
  tag: string;
  type: string;
  now: string;
  members: NodeStatus[];
}

export interface DNSStatus {
  enabled: boolean;
  listen?: string;
  err?: string;
}

export interface Status {
  phase: string;
  reason?: string;
  since_unix: number;
  uptime_sec: number;
  version: string;
  mode: string;
  tun: TunStatus;
  inbounds: InboundStatus[];
  health: Health;
  traffic: Traffic;
  groups: GroupStatus[];
  dns: DNSStatus;
}

